# Copy to .env and fill in real values. Never commit .env.

# Database. docker-compose overrides this to point at the `db` service
# (see infra/docker/docker-compose.yml); this default targets a local/native Postgres.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/github_intelligence

# Redis (background worker broker/result backend).
REDIS_URL=redis://localhost:6379/0

# GitHub Personal Access Token, read-only scopes (classic: `repo` for private repos or
# `public_repo` for public-only; fine-grained: Contents/Issues/Pull requests read-only).
GITHUB_TOKEN=

# Fernet key encrypting the token at rest in github_connections. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# App
ENVIRONMENT=local
LOG_LEVEL=INFO
